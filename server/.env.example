PORT=8000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accountsmaster

JWT_SECRET=salesmaster_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=salesmaster_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Public base URL of the member portal — used to build absolute links in
# emails (e.g. the member approval email's login link).
PORTAL_BASE_URL=http://localhost:8800

# Email verification codes (registration) — leave blank to log codes to the
# server console instead of sending real emails (useful for dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Accounts Master <no-reply@accountsmaster.com>
